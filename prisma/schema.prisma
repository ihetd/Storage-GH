// Prisma schema for the shop inventory / stock management app.
// See README for setup. Postgres via a local Homebrew service by default.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app (e.g. Neon's -pooler host on Vercel).
  url       = env("DATABASE_URL")
  // Direct connection for migrations (`prisma migrate deploy`). Locally this is
  // the same as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

// Where a stock change came from. The distinction is load-bearing, not
// decorative: MANUAL and ADMIN_EDIT originate here and are pushed up to
// Shopify, while the SHOPIFY_* ones arrived from Shopify and must never be
// echoed back or the two systems chase each other.
enum AdjustmentSource {
  MANUAL
  ADMIN_EDIT
  SHOPIFY_ORDER
  SHOPIFY_CANCEL
  SHOPIFY_REFUND
  RECONCILE
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  role         Role     @default(VIEWER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  adjustments StockAdjustment[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

// Reusable set of variant options (e.g. "Clothing Sizes": Size -> [S, M, L, XL]).
model VariantTemplate {
  id             String   @id @default(cuid())
  name           String   @unique
  attributeLabel String   @default("Size")
  options        String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]
}

model Product {
  id                String   @id @default(cuid())
  name              String
  imageUrl          String?
  imageKey          String?
  attributeLabel    String   @default("Size")
  categoryId        String
  variantTemplateId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Shopify keeps colours as one product with a colour option; this app keeps
  // one attribute axis per product. So the link is per product *and* colour:
  // "Light Pant / Black" here points at Shopify's Light Pant, option "Black".
  // shopifyOptionValue is null for products that have no second axis.
  shopifyProductId   String?
  shopifyOptionValue String?

  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variantTemplate VariantTemplate? @relation(fields: [variantTemplateId], references: [id], onDelete: SetNull)
  variants        ProductVariant[]

  @@unique([shopifyProductId, shopifyOptionValue])
  @@index([categoryId])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String
  label     String
  quantity  Int    @default(0)
  sortOrder Int    @default(0)

  // Resolved once when the product is linked, so an incoming webhook is an
  // indexed lookup by id rather than a label match at request time.
  // inventoryItemId is what the inventory mutations address; variantId is what
  // order webhooks carry.
  shopifyVariantId       String? @unique
  shopifyInventoryItemId String? @unique

  // Existing rows predate this column, hence the default alongside @updatedAt.
  updatedAt DateTime @default(now()) @updatedAt

  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  adjustments StockAdjustment[]

  @@unique([productId, label])
  @@index([productId])
}

// Minimal audit trail: who changed what stock, by how much, and the resulting qty.
model StockAdjustment {
  id               String           @id @default(cuid())
  productVariantId String
  // Null when Shopify made the change: there is no human author to point at.
  userId           String?
  delta            Int
  resultingQty     Int
  source           AdjustmentSource @default(MANUAL)
  // The Shopify order or refund id behind the change. Paired with the variant
  // in a unique index, this is what makes webhook retries idempotent: Shopify
  // redelivers freely, and the second insert simply loses.
  externalRef      String?
  createdAt        DateTime         @default(now())

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([externalRef, productVariantId])
  @@index([productVariantId])
  @@index([userId])
}

// Shopify's client-credentials tokens expire after 24 hours, so one is minted,
// stored and reused rather than fetched on every call. Single row, fixed id.
model ShopifyToken {
  id          String   @id @default("singleton")
  accessToken String
  scope       String
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt
}

// Result of one nightly comparison between this app and Shopify.
//
// The sync is event-driven, and events can be lost: Shopify retries a failed
// webhook for two days and then gives up, and a push can fail while its local
// change stands. Nothing in that path notices, so the two counts would simply
// disagree in silence. This is the thing that notices.
//
// Read-only by design. Vercel says cron delivery is best effort and may fire
// twice, so a job that only looks and records is safe to run any number of
// times.
model ReconcileRun {
  id       String   @id @default(cuid())
  ranAt    DateTime @default(now())
  /** Linked variants compared. */
  checked  Int
  /** Of those, how many disagreed. */
  drifted  Int
  /** Linked here but no longer present in Shopify — a deleted or re-made variant. */
  missing  Int
  /** The disagreements themselves, for the dashboard to list. */
  details  Json?
  /** Set when the run itself failed, so a silent absence is distinguishable. */
  error    String?

  @@index([ranAt])
}
