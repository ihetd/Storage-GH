// Prisma schema for the shop inventory / stock management app.
// See README for setup. Postgres via a local Homebrew service by default.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app (e.g. Neon's -pooler host on Vercel).
  url       = env("DATABASE_URL")
  // Direct connection for migrations (`prisma migrate deploy`). Locally this is
  // the same as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  role         Role     @default(VIEWER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  adjustments StockAdjustment[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]
}

// Reusable set of variant options (e.g. "Clothing Sizes": Size -> [S, M, L, XL]).
model VariantTemplate {
  id             String   @id @default(cuid())
  name           String   @unique
  attributeLabel String   @default("Size")
  options        String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]
}

model Product {
  id                String   @id @default(cuid())
  name              String
  imageUrl          String?
  imageKey          String?
  attributeLabel    String   @default("Size")
  categoryId        String
  variantTemplateId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variantTemplate VariantTemplate? @relation(fields: [variantTemplateId], references: [id], onDelete: SetNull)
  variants        ProductVariant[]

  @@index([categoryId])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String
  label     String
  quantity  Int    @default(0)
  sortOrder Int    @default(0)

  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  adjustments StockAdjustment[]

  @@unique([productId, label])
  @@index([productId])
}

// Minimal audit trail: who changed what stock, by how much, and the resulting qty.
model StockAdjustment {
  id               String   @id @default(cuid())
  productVariantId String
  userId           String
  delta            Int
  resultingQty     Int
  createdAt        DateTime @default(now())

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productVariantId])
  @@index([userId])
}
